---
import logo from "../../assets/eudaspace-logo.png";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: base, label: "Home", key: "home" },
  { href: `${base}products-and-paint/#products`, label: "Products", key: "products" },
  { href: `${base}products-and-paint/#paints`, label: "Paints", key: "paints" },
  { href: `${base}trades/`, label: "Trades", key: "trades" },
  { href: `${base}methodology/`, label: "Methodology", key: "methodology" },
  { href: "mailto:harj@eudaspace.co.uk", label: "Work with Harj", key: "audit" },
];

function current(link: { href: string; key: string }) {
  if (link.key === "home") return path === base;
  if (link.key === "trades") return path.startsWith(`${base}trades`);
  if (link.key === "methodology") return path.startsWith(`${base}methodology`);
  return false;
}
---

<a class="skip" href="#main">Skip to main content</a>
<header class="site">
  <div class="wrap">
    <a class="brand" href={base} aria-label="Eudaspace Calm Home Directory, home">
      <img src={logo.src} alt="Eudaspace" width="124" height="34" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                id={link.key === "audit" ? undefined : `nav-${link.key}`}
                href={link.href}
                aria-label={link.key === "audit" ? "Work with Harj, the £195 floorplan and colour audit" : undefined}
                aria-current={current(link) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
<script>
  const path = location.pathname;
  if (path.includes("/products-and-paint/")) {
    const key = location.hash === "#paints" ? "paints" : "products";
    document.getElementById(`nav-${key}`)?.setAttribute("aria-current", "page");
  }
  window.addEventListener("hashchange", () => {
    for (const key of ["products", "paints"]) {
      document.getElementById(`nav-${key}`)?.removeAttribute("aria-current");
    }
    if (!location.pathname.includes("/products-and-paint/")) return;
    const key = location.hash === "#paints" ? "paints" : "products";
    document.getElementById(`nav-${key}`)?.setAttribute("aria-current", "page");
  });
</script>
