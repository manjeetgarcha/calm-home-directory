---
import logo from "../../assets/eudaspace-logo.png";
---

<section class="alt" aria-label="Floorplan and colour audit">
  <div class="wrap">
    <div class="lead-card">
      <img src={logo.src} alt="Eudaspace" width="200" height="55" />
      <div>
        <span class="pin">£195</span>
        <h2>Work with Harj</h2>
        <p>
          <a href="mailto:harj@eudaspace.co.uk">
            Not sure how your room's light interacts with your furniture? Book a £195 Eudaspace Floorplan &amp; Colour Video Audit
          </a>
        </p>
        <div class="btns">
          <a class="btn" href="mailto:harj@eudaspace.co.uk">Email Harj about the audit</a>
        </div>
      </div>
    </div>
  </div>
</section>
