---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base
  title="Page not found | Surrey & London Calm Home Directory"
  description="This address is not a page on the Eudaspace Calm Home Directory."
>
  <div class="wrap page-intro">
    <h1>This page is not published</h1>
    <p class="lede">The address does not match a page on the directory.</p>
    <p>
      <a class="button button-primary" href={base}>Back to the home page</a>
    </p>
  </div>
</Base>
