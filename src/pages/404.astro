---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base
  title="Page not found | Surrey & London Calm Home Directory"
  description="This address is not a page on the Eudaspace Calm Home Directory."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Missing page</p>
      <h1>This page is not published</h1>
      <p class="lead">The address does not match a page on the directory.</p>
      <div class="btns">
        <a class="btn" href={base}>Back to the home page</a>
      </div>
    </div>
  </section>
</Base>
