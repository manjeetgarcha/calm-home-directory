---
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const description =
  "Surrey and London Calm Home Trade Directory of builders, architects and other trades. Coming soon. No businesses are listed yet. Write to harj@eudaspace.co.uk.";
---

<Base title="Trades, builders & architects | Surrey & London Calm Home Directory" description={description}>
  <div class="wrap page-intro method">
    <nav aria-label="Breadcrumb">
      <ol class="crumb">
        <li><a href={base}>Home</a></li>
        <li aria-current="page">Trades, builders &amp; architects</li>
      </ol>
    </nav>
    <p class="eyebrow">Surrey &amp; London Calm Home Trade Directory</p>
    <h1>Trades, builders &amp; architects</h1>
    <p class="lede">
      This page will list builders, architects and other trades who work on calm homes in
      Surrey and London. It is coming soon. There is no list here yet, because I do not have
      one I can stand behind.
    </p>
    <article class="panel">
      <h2>Coming soon</h2>
      <p>
        I have not published any businesses. I would rather leave this empty than invent a
        joiner, an architect, or a decorator. When a real listing exists, it will go here
        with the source named.
      </p>
      <p>
        Get in touch if you work in Surrey or London and want to be considered, or if you
        are looking for a trade and want to ask me directly.
      </p>
      <p>
        <a class="button button-primary" href="mailto:harj@eudaspace.co.uk">Get in touch at harj@eudaspace.co.uk</a>
      </p>
    </article>
  </div>
</Base>
